{
  "name": "qq-bridge-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QQ-Bridge 管理端 — 集成 NapCat 与 DSH 官方界面",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node server/index.js\"",
